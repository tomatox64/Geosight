/* Geosight Cinematic Dark Theme — Dark Mode (OLED) + Modern Dark (Cinema) */
/* Based on UI-UX-Pro-Max design intelligence */

/* Global */
QWidget {
    background-color: #0a0a0f;
    color: #c9d1d9;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: #0a0a0f;
}

QStatusBar {
    background-color: #050508;
    color: #8b949e;
    border-top: 0.5px solid rgba(255,255,255,0.06);
    padding: 4px 12px;
    font-size: 9pt;
}

/* Scrollbar — thin, subtle */
QScrollBar:vertical {
    background: #050508;
    width: 6px;
    border: none;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.10);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(94,106,210,0.5);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* Sidebar — cinematic gradient */
QListWidget {
    background-color: #06060a;
    border: none;
    outline: none;
    padding: 2px;
}
QListWidget::item {
    background-color: transparent;
    color: #8b949e;
    padding: 11px 14px;
    margin: 2px 6px;
    border-radius: 6px;
    border: 0.5px solid transparent;
    font-size: 10pt;
}
QListWidget::item:hover {
    background-color: rgba(94,106,210,0.08);
    color: #c9d1d9;
    border: 0.5px solid rgba(94,106,210,0.15);
}
QListWidget::item:selected {
    background-color: rgba(94,106,210,0.15);
    color: #8bb4ff;
    border: 0.5px solid rgba(94,106,210,0.3);
    font-weight: bold;
}

/* Group Box — glass morphism */
QGroupBox {
    background-color: rgba(255,255,255,0.02);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
    color: #c9d1d9;
    font-size: 10pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #8bb4ff;
}

/* Push Button */
QPushButton {
    background-color: rgba(255,255,255,0.05);
    color: #c9d1d9;
    border: 0.5px solid rgba(255,255,255,0.10);
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: rgba(255,255,255,0.08);
    border-color: rgba(94,106,210,0.4);
}
QPushButton:pressed {
    background-color: rgba(94,106,210,0.15);
}
QPushButton:disabled {
    background-color: rgba(255,255,255,0.02);
    color: #484f58;
    border-color: rgba(255,255,255,0.04);
}

/* Next step button — green glow */
QPushButton[cssClass="nextButton"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #1a6b3c,stop:1 #238636);
    color: #ffffff;
    border: 0.5px solid rgba(46,160,67,0.4);
    font-size: 11pt;
    font-weight: bold;
    padding: 10px 24px;
    border-radius: 8px;
}
QPushButton[cssClass="nextButton"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #238636,stop:1 #2ea043);
    border-color: rgba(46,160,67,0.6);
}
QPushButton[cssClass="nextButton"]:disabled {
    background: rgba(255,255,255,0.03);
    color: #484f58;
    border-color: rgba(255,255,255,0.05);
}

/* Run button — indigo glow */
QPushButton[cssClass="runButton"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #3730a3,stop:1 #4f46e5);
    color: #ffffff;
    border: 0.5px solid rgba(99,102,241,0.4);
    font-size: 10pt;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
}
QPushButton[cssClass="runButton"]:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #4f46e5,stop:1 #6366f1);
    border-color: rgba(99,102,241,0.6);
}
QPushButton[cssClass="runButton"]:disabled {
    background: rgba(255,255,255,0.03);
    color: #484f58;
    border-color: rgba(255,255,255,0.05);
}

/* Card — elevated glass */
QFrame[cssClass="card"] {
    background-color: rgba(255,255,255,0.03);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 14px;
}

/* Table — data-dense clear */
QTableWidget {
    background-color: rgba(255,255,255,0.02);
    alternate-background-color: rgba(255,255,255,0.03);
    border: 0.5px solid rgba(255,255,255,0.08);
    gridline-color: rgba(255,255,255,0.04);
    selection-background-color: rgba(94,106,210,0.15);
    color: #c9d1d9;
    border-radius: 6px;
}
QTableWidget::item {
    padding: 4px 10px;
    border: none;
}
QHeaderView::section {
    background-color: rgba(255,255,255,0.04);
    color: #8b949e;
    border: none;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    padding: 6px 10px;
    font-weight: bold;
    font-size: 9pt;
}

/* Progress Bar — subtle pulse */
QProgressBar {
    background-color: rgba(255,255,255,0.04);
    border: 0.5px solid rgba(255,255,255,0.06);
    border-radius: 4px;
    text-align: center;
    height: 4px;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #4f46e5,stop:1 #6366f1);
    border-radius: 3px;
}

/* Text Edit (log) — terminal style */
QTextEdit {
    background-color: #050508;
    border: 0.5px solid rgba(255,255,255,0.06);
    border-radius: 6px;
    padding: 8px;
    color: #7ee787;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

/* Labels — neon accents */
QLabel[cssClass="accentValue"] {
    color: #8bb4ff;
    font-size: 18pt;
    font-weight: bold;
}
QLabel[cssClass="successValue"] {
    color: #3bf0b0;
    font-size: 18pt;
    font-weight: bold;
}
QLabel[cssClass="warningValue"] {
    color: #f0c040;
    font-size: 18pt;
    font-weight: bold;
}
QLabel[cssClass="dangerValue"] {
    color: #ff6b6b;
    font-size: 18pt;
    font-weight: bold;
}

QLabel[cssClass="titleLabel"] {
    font-size: 20pt;
    font-weight: bold;
    color: #f0f6fc;
    padding-bottom: 4px;
}
QLabel[cssClass="subtitleLabel"] {
    font-size: 10pt;
    color: #8b949e;
    padding-bottom: 12px;
}
QLabel[cssClass="cardLabel"] {
    font-size: 9pt;
    color: #8b949e;
}
QLabel[cssClass="statusLabel"] {
    font-size: 9pt;
    color: #8b949e;
}

/* Splitter — whisper thin */
QSplitter::handle {
    background-color: rgba(255,255,255,0.06);
    width: 1px;
}

/* ComboBox */
QComboBox {
    background-color: rgba(255,255,255,0.05);
    color: #c9d1d9;
    border: 0.5px solid rgba(255,255,255,0.10);
    border-radius: 6px;
    padding: 4px 8px;
}
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #0a0a0f;
    border: 0.5px solid rgba(255,255,255,0.10);
    selection-background-color: rgba(94,106,210,0.15);
}

/* ── Icon Tab Bar ── */
#IconTabBar {
    background-color: #06060a;
    border-right: 0.5px solid rgba(255,255,255,0.05);
}

QToolButton[cssClass="iconTab"] {
    background-color: transparent;
    color: #8b949e;
    border: none;
    border-radius: 6px;
    font-size: 7pt;
    padding: 6px 2px;
    margin: 1px 4px;
}

QToolButton[cssClass="iconTab"]:hover {
    background-color: rgba(94,106,210,0.10);
    color: #c9d1d9;
}

QToolButton[cssClass="iconTab"]:checked {
    background-color: rgba(94,106,210,0.18);
    color: #8bb4ff;
    font-weight: bold;
}

/* ── Property Panel ── */
#PropertyPanel {
    background-color: #0a0a0f;
    border-left: 0.5px solid rgba(255,255,255,0.06);
}

#panelHeader {
    background-color: #06060a;
    border-bottom: 0.5px solid rgba(255,255,255,0.06);
}

#panelTitle {
    font-size: 12pt;
    font-weight: bold;
    color: #f0f6fc;
}

#panelSubtitle {
    font-size: 8pt;
    color: #484f58;
}

#panelScroll {
    background-color: transparent;
    border: none;
}

#panelScroll QWidget {
    background-color: transparent;
}

/* ── Viewport Manager ── */
#ViewportManager {
    background-color: #1a1a2e;
    border: none;
}

/* ── Compact Table (narrow panel) ── */
QTableWidget[cssClass="compactTable"] {
    font-size: 8pt;
}
QTableWidget[cssClass="compactTable"] QHeaderView::section {
    font-size: 7pt;
    padding: 3px 6px;
}
QTableWidget[cssClass="compactTable"]::item {
    padding: 2px 6px;
}
